{
  "id": "between-pages",
  "name": "页间",
  "label": "AI 消费产品 / 体验与恢复",
  "date": "2026-09-20",
  "title": "保留拆书体验，也处理请求中断后的残局。",
  "intro": "通过情绪线索和拆封交互发现书籍的阅读盲盒，区分轻量随机与 AI 推敲。",
  "problem": "外部书库与模型的不确定性会影响体验；请求取消遗留全站锁，会让后续访客持续等待。",
  "decisions": [
    "把不调用模型的随机抽书与消耗机会的 AI 推敲分开，保留额度耗尽后的轻量路径。",
    "模型只从真实候选中选择；资料不足、模型失败和额度不足分别处理。",
    "引入请求级取消、过期租约与受保护的清理流程，避免旧任务覆盖新任务。"
  ],
  "outcomes": [
    "交接记录保存 85 项自动测试及构建、lint 通过的历史结果。",
    "源码和回归用例包含请求取消、租约释放、退款与中断恢复。",
    "保留了桌面与手机界面截图；衍生电影或艺术品产品需单独做领域适配。"
  ],
  "limits": "85 项为 2026-09-20 交接记录中的结果，本轮静态核对了实现与相关用例，未重新执行全套测试。历史线上抽取复测受 403 阻挡，不能列为真实外部书库端到端验收通过；当前线上可用性未重新验证。",
  "lesson": "将产品规则、费用边界和失败恢复一起设计，让体验在外部依赖失败时仍可解释。",
  "skills": [
    "requirements-shaping",
    "product-variant-extraction",
    "failure-learning",
    "delivery-acceptance"
  ],
  "image": "assets/between-pages.png",
